diff --git a/core/tests/test_cancellation.py b/core/tests/test_cancellation.py
new file mode 100644
index 0000000..638a88d
--- /dev/null
+++ b/core/tests/test_cancellation.py
@@ -0,0 +1,415 @@
+"""Cancellation, timeouts and retries of pipeline stages.
+
+These tests pin the behaviour the GUI depends on: a user cancel stops the run
+without pretending the stage finished, a timeout fails only its own stage, and a
+failing stage gets its retries while a cancel never does.
+"""
+
+import threading
+import time
+
+import pytest
+
+from app import adapters
+from app.core.cancellation import (
+    CancelToken,
+    StageCancelled,
+    StageTimeout,
+)
+from app.core.pipeline import Pipeline
+from app.core.pipeline_context import PipelineContext
+from app.core.pipeline_state import PipelineState
+from app.core.stage_handler import StageHandler, StageOutcome
+from app.models.pipeline_stage import PipelineStage
+from app.models.stage_state import StageStatus
+from projects.project import Project
+
+
+def make_context(tmp_path) -> PipelineContext:
+    source_video = tmp_path / "video.mp4"
+    source_video.touch()
+
+    project = Project.create(
+        source_video=source_video,
+        projects_dir=tmp_path / "projects",
+    )
+    project.project_dir.mkdir(parents=True, exist_ok=True)
+
+    return PipelineContext(project=project)
+
+
+def ok_handler(log, name="stage", **kwargs) -> StageHandler:
+    def run(_context):
+        log.append(name)
+        return StageOutcome(value=name)
+
+    return StageHandler(run=run, **kwargs)
+
+
+# -- the token itself -------------------------------------------------------------------
+
+
+def test_a_child_token_is_cancelled_by_its_parent():
+    parent = CancelToken()
+    child = parent.child()
+
+    assert not child.cancelled
+
+    parent.request("user asked to stop")
+
+    assert child.cancelled
+    assert child.reason == "user asked to stop"
+
+
+def test_a_child_cancel_does_not_reach_its_sibling():
+    parent = CancelToken()
+    first = parent.child()
+    second = parent.child()
+
+    first.request("timeout", 5.0)
+
+    assert first.cancelled
+    assert not second.cancelled
+    assert not parent.cancelled
+
+
+def test_raise_if_cancelled_keeps_the_reason():
+    cancelled = CancelToken()
+    cancelled.request("user asked to stop")
+
+    with pytest.raises(StageCancelled) as exc:
+        cancelled.raise_if_cancelled()
+
+    assert exc.value.reason == "user asked to stop"
+
+    timed_out = CancelToken()
+    timed_out.request("timeout", 12.5)
+
+    with pytest.raises(StageTimeout) as exc:
+        timed_out.raise_if_cancelled()
+
+    assert exc.value.seconds == 12.5
+
+
+def test_a_token_that_was_never_asked_does_nothing():
+    CancelToken().raise_if_cancelled()
+
+
+# -- the pipeline -----------------------------------------------------------------------
+
+
+def test_cancel_before_a_stage_stops_the_run(tmp_path):
+    context = make_context(tmp_path)
+    token = CancelToken()
+    ran = []
+
+    pipeline = Pipeline(
+        context=context,
+        cancel=token,
+        handlers={PipelineStage.ANALYSIS: ok_handler(ran, "analysis")},
+    )
+    token.request("user asked to stop")
+    pipeline.run()
+
+    analysis = pipeline.state.get(PipelineStage.ANALYSIS.value)
+
+    assert ran == []
+    assert analysis.status == StageStatus.CANCELLED
+    assert "Cancelled before analysis" in analysis.message
+
+    # The run stops instead of walking the remaining stages.
+    assert pipeline.state.get(PipelineStage.EXTRACT_AUDIO.value).message == ""
+
+
+def test_cancel_during_a_stage_marks_it_cancelled_and_stops(tmp_path):
+    context = make_context(tmp_path)
+    token = CancelToken()
+    ran = []
+
+    def stopper(_context):
+        ran.append("analysis")
+        token.request("user asked to stop")
+        return StageOutcome(value="half done")
+
+    pipeline = Pipeline(
+        context=context,
+        cancel=token,
+        handlers={
+            PipelineStage.ANALYSIS: StageHandler(run=stopper),
+            PipelineStage.EXTRACT_AUDIO: ok_handler(ran, "extract_audio"),
+        },
+    )
+    pipeline.run()
+
+    analysis = pipeline.state.get(PipelineStage.ANALYSIS.value)
+
+    # The stage returned, but it was stopped on purpose: it is not completed.
+    assert ran == ["analysis"]
+    assert analysis.status == StageStatus.CANCELLED
+    assert not pipeline.state.is_completed(PipelineStage.ANALYSIS.value)
+    assert pipeline.state.get(PipelineStage.EXTRACT_AUDIO.value).message == ""
+
+
+def test_a_user_cancel_is_never_retried(tmp_path):
+    context = make_context(tmp_path)
+    attempts = []
+
+    def stopper(_context):
+        attempts.append(1)
+        raise StageCancelled("user asked to stop")
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={
+            PipelineStage.ANALYSIS: StageHandler(run=stopper, retries=5),
+        },
+    )
+    pipeline.run()
+
+    assert len(attempts) == 1
+    assert pipeline.state.get(PipelineStage.ANALYSIS.value).status == StageStatus.CANCELLED
+
+
+def test_timeout_fails_the_stage_and_the_run_continues(tmp_path):
+    context = make_context(tmp_path)
+    finished = []
+
+    def slow(_context):
+        time.sleep(0.4)
+        return StageOutcome(value="late")
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={
+            PipelineStage.ANALYSIS: StageHandler(run=slow, timeout=0.05),
+            PipelineStage.EXTRACT_AUDIO: ok_handler(finished, "extract_audio"),
+        },
+    )
+    pipeline.run()
+
+    analysis = pipeline.state.get(PipelineStage.ANALYSIS.value)
+    extract = pipeline.state.get(PipelineStage.EXTRACT_AUDIO.value)
+
+    assert analysis.status == StageStatus.FAILED
+    assert "timeout" in analysis.message
+
+    # A timeout fails only its own stage: the run keeps going and the dependent
+    # stage is blocked, not cancelled, so the run can resume later.
+    assert extract.status == StageStatus.NOT_STARTED
+    assert "Dependencies not completed" in extract.message
+    assert finished == []
+
+
+def test_a_timed_out_stage_is_retried(tmp_path):
+    context = make_context(tmp_path)
+    attempts = []
+
+    def slow(_context):
+        attempts.append(1)
+        time.sleep(0.3)
+        return StageOutcome(value="late")
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={
+            PipelineStage.ANALYSIS: StageHandler(run=slow, timeout=0.05, retries=2),
+        },
+    )
+    pipeline.run()
+
+    assert len(attempts) == 3
+    assert pipeline.state.get(PipelineStage.ANALYSIS.value).status == StageStatus.FAILED
+
+
+def test_retries_let_a_flaky_stage_finish(tmp_path):
+    context = make_context(tmp_path)
+    attempts = []
+
+    def flaky(_context):
+        attempts.append(1)
+
+        if len(attempts) < 3:
+            raise RuntimeError("transient boom")
+
+        return StageOutcome(value="ok")
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={
+            PipelineStage.ANALYSIS: StageHandler(run=flaky, retries=2),
+        },
+    )
+    pipeline.run()
+
+    analysis = pipeline.state.get(PipelineStage.ANALYSIS.value)
+
+    assert len(attempts) == 3
+    assert analysis.status == StageStatus.COMPLETED
+    assert analysis.progress == 1.0
+
+
+def test_without_retries_a_failure_stays_a_failure(tmp_path):
+    context = make_context(tmp_path)
+    attempts = []
+
+    def broken(_context):
+        attempts.append(1)
+        raise RuntimeError("boom")
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={PipelineStage.ANALYSIS: StageHandler(run=broken)},
+    )
+    pipeline.run()
+
+    assert len(attempts) == 1
+    assert pipeline.state.get(PipelineStage.ANALYSIS.value).status == StageStatus.FAILED
+
+
+def test_the_deadline_is_per_attempt(tmp_path):
+    context = make_context(tmp_path)
+    durations = []
+
+    def slow(_context):
+        started = time.monotonic()
+        time.sleep(0.15)
+        durations.append(time.monotonic() - started)
+        return StageOutcome(value="ok")
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={
+            PipelineStage.ANALYSIS: StageHandler(run=slow, timeout=1.0, retries=1),
+        },
+    )
+    pipeline.run()
+
+    # A generous deadline must not fire on the second attempt just because the
+    # first one used it.
+    assert len(durations) == 1
+    assert pipeline.state.get(PipelineStage.ANALYSIS.value).status == StageStatus.COMPLETED
+
+
+def test_the_context_carries_the_stage_token(tmp_path):
+    context = make_context(tmp_path)
+    seen = []
+
+    def watch(run_context):
+        seen.append(run_context.cancel)
+        return StageOutcome(value="ok")
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={PipelineStage.ANALYSIS: StageHandler(run=watch)},
+    )
+    pipeline.run()
+
+    assert len(seen) == 1
+    assert seen[0] is not None
+    # The token is gone once the stage is over: a stale token must not be polled.
+    assert context.cancel is None
+
+
+def test_cancelled_status_survives_a_reload(tmp_path):
+    context = make_context(tmp_path)
+    state = PipelineState()
+    state.get(PipelineStage.ANALYSIS.value).status = StageStatus.CANCELLED
+    state.save(context.project_dir)
+
+    restored = PipelineState.load(context.project_dir)
+
+    assert restored.get(PipelineStage.ANALYSIS.value).status == StageStatus.CANCELLED
+    assert not restored.is_completed(PipelineStage.ANALYSIS.value)
+
+
+def test_request_cancel_stops_the_next_stage(tmp_path):
+    context = make_context(tmp_path)
+    ran = []
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={
+            PipelineStage.ANALYSIS: ok_handler(ran, "analysis"),
+            PipelineStage.EXTRACT_AUDIO: ok_handler(ran, "extract_audio"),
+        },
+    )
+
+    # A GUI calls this from another thread; the pipeline stops between stages.
+    def cancel_from_another_thread():
+        pipeline.request_cancel("user closed the window")
+
+    worker = threading.Thread(target=cancel_from_another_thread)
+    worker.start()
+    worker.join()
+    pipeline.run()
+
+    assert ran == []
+    assert pipeline.state.get(PipelineStage.ANALYSIS.value).status == StageStatus.CANCELLED
+
+
+# -- the runner that owns the process ----------------------------------------------------
+
+
+def test_subprocess_runner_stops_a_running_stage_process(tmp_path):
+    token = CancelToken()
+    script = tmp_path / "stage.py"
+    script.write_text("import time\n\ntime.sleep(30)\nprint('never printed')\n")
+    log_path = tmp_path / "stage.log"
+
+    timer = threading.Timer(0.4, token.request, args=("user asked to stop",))
+    timer.daemon = True
+    timer.start()
+
+    started = time.monotonic()
+
+    with pytest.raises(StageCancelled):
+        adapters.subprocess_runner(
+            ["python3", str(script)],
+            {},
+            tmp_path,
+            log_path,
+            cancel=token,
+        )
+
+    elapsed = time.monotonic() - started
+    timer.cancel()
+
+    # 30 s of sleep must not be waited out: the process is stopped instead.
+    assert elapsed < 15
+    text = log_path.read_text()
+    assert "stage stopped" in text
+    assert "never printed" not in text
+
+
+def test_subprocess_runner_reports_a_timeout_as_such(tmp_path):
+    token = CancelToken()
+    script = tmp_path / "stage.py"
+    script.write_text("import time\n\ntime.sleep(30)\n")
+    log_path = tmp_path / "stage.log"
+
+    timer = threading.Timer(0.3, token.request, args=("timeout", 0.3))
+    timer.daemon = True
+    timer.start()
+
+    with pytest.raises(StageTimeout):
+        adapters.subprocess_runner(
+            ["python3", str(script)],
+            {},
+            tmp_path,
+            log_path,
+            cancel=token,
+        )
+
+    timer.cancel()
+    assert "stage stopped (timeout)" in log_path.read_text()
+
+
+def test_subprocess_runner_without_a_token_still_reports_failures(tmp_path):
+    script = tmp_path / "stage.py"
+    script.write_text("import sys\n\nprint('bad', file=sys.stderr)\nsys.exit(3)\n")
+    log_path = tmp_path / "stage.log"
+
+    with pytest.raises(adapters.AdapterError) as exc:
+        adapters.subprocess_runner(["python3", str(script)], {}, tmp_path, log_path)
+
+    assert "exit code 3" in str(exc.value)
diff --git a/core/tests/test_cli_parity.py b/core/tests/test_cli_parity.py
new file mode 100644
index 0000000..87b3764
--- /dev/null
+++ b/core/tests/test_cli_parity.py
@@ -0,0 +1,146 @@
+"""The core's stage table must not drift from scripts/cli.py.
+
+The engine's own driver declares the same twelve stages a second time, and that
+duplication already caused one real defect: cli.py declared the wrong artifact for
+``segment_merge``, so a stale ``translated_segments.json`` was reused and the dub
+went silent at 3:30. Until the table has a single source, this test makes the two
+copies fail loudly instead of drifting quietly.
+
+It reads cli.py as source (no import, no side effects) and compares the declared
+phase order, the script of each stage and the artifact each stage publishes.
+"""
+
+import ast
+from pathlib import Path
+
+from app.adapters import ENGINE_STAGES
+
+CLI = Path(__file__).resolve().parents[2] / "scripts" / "cli.py"
+
+
+def cli_tree() -> ast.Module:
+    return ast.parse(CLI.read_text(encoding="utf-8"))
+
+
+def find_function(tree: ast.Module, name: str) -> ast.FunctionDef:
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and node.name == name:
+            return node
+
+    raise AssertionError(f"{name}() not found in {CLI}")
+
+
+def phase_tuples(process: ast.FunctionDef) -> list[ast.Tuple]:
+    """The tuples that build ``phases``, in source order.
+
+    ``ast.walk`` is breadth first, which would reorder the stages, so the tuples are
+    collected and then sorted by line: the declaration order is part of the contract.
+    """
+
+    found: list[ast.Tuple] = []
+
+    for node in ast.walk(process):
+        if isinstance(node, ast.Assign) and any(
+            isinstance(target, ast.Name) and target.id == "phases"
+            for target in node.targets
+        ):
+            if isinstance(node.value, ast.List):
+                for element in node.value.elts:
+                    if isinstance(element, ast.Tuple):
+                        found.append(element)
+
+        if (
+            isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and node.func.attr in ("append", "extend")
+        ):
+            for argument in node.args:
+                if isinstance(argument, ast.Tuple):
+                    found.append(argument)
+                elif isinstance(argument, ast.List):
+                    for element in argument.elts:
+                        if isinstance(element, ast.Tuple):
+                            found.append(element)
+
+    return sorted(found, key=lambda phase: phase.lineno)
+
+
+def script_of(phase: ast.Tuple) -> str | None:
+    for node in ast.walk(phase):
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
+            if node.func.id == "run_script" and node.args:
+                first = node.args[0]
+                if isinstance(first, ast.Constant) and isinstance(first.value, str):
+                    return first.value
+
+    return None
+
+
+def declared_phases(process: ast.FunctionDef) -> tuple[list[str], dict[str, str]]:
+    names: list[str] = []
+    scripts: dict[str, str] = {}
+
+    for phase in phase_tuples(process):
+        if not phase.elts:
+            continue
+
+        first = phase.elts[0]
+        if not (isinstance(first, ast.Constant) and isinstance(first.value, str)):
+            continue
+
+        name = first.value
+
+        if name not in names:
+            names.append(name)
+
+        script = script_of(phase)
+
+        if script is not None:
+            scripts.setdefault(name, script)
+
+    return names, scripts
+
+
+def declared_outputs(process: ast.FunctionDef) -> dict[str, str | None]:
+    for node in ast.walk(process):
+        if isinstance(node, ast.Assign) and any(
+            isinstance(target, ast.Name) and target.id == "outputs"
+            for target in node.targets
+        ):
+            if isinstance(node.value, ast.Dict):
+                outputs: dict[str, str | None] = {}
+
+                for key, value in zip(node.value.keys, node.value.values):
+                    if not (isinstance(key, ast.Constant) and isinstance(key.value, str)):
+                        continue
+
+                    outputs[key.value] = (
+                        value.value
+                        if isinstance(value, ast.Constant) and isinstance(value.value, str)
+                        else None
+                    )
+
+                return outputs
+
+    raise AssertionError(f"no outputs table found in process() of {CLI}")
+
+
+def test_cli_and_core_declare_the_same_stages_in_the_same_order():
+    process = find_function(cli_tree(), "process")
+    names, _scripts = declared_phases(process)
+
+    assert names == [spec.name for spec in ENGINE_STAGES]
+
+
+def test_each_stage_runs_the_script_the_core_expects():
+    process = find_function(cli_tree(), "process")
+    _names, scripts = declared_phases(process)
+
+    assert scripts == {spec.name: spec.script for spec in ENGINE_STAGES}
+
+
+def test_each_stage_publishes_the_artifact_the_core_expects():
+    process = find_function(cli_tree(), "process")
+    outputs = declared_outputs(process)
+
+    assert outputs == {spec.name: spec.artifact for spec in ENGINE_STAGES}
diff --git a/core/tests/test_progress.py b/core/tests/test_progress.py
new file mode 100644
index 0000000..4ee7378
--- /dev/null
+++ b/core/tests/test_progress.py
@@ -0,0 +1,209 @@
+"""Progress inside a long stage.
+
+A stage that runs for hours must say where it is: these tests pin that a log line
+becomes progress, that the state carries it while the stage runs, and that a
+broken reader can never fail a stage that is working.
+"""
+
+import pytest
+
+from app import adapters
+from app.core.pipeline import Pipeline
+from app.core.pipeline_context import PipelineContext
+from app.core.progress import LogProgress
+from app.core.stage_handler import StageHandler, StageOutcome
+from app.models.pipeline_stage import PipelineStage
+from app.models.stage_state import StageStatus
+from projects.project import Project
+
+
+def make_context(tmp_path) -> PipelineContext:
+    source_video = tmp_path / "video.mp4"
+    source_video.touch()
+
+    project = Project.create(
+        source_video=source_video,
+        projects_dir=tmp_path / "projects",
+    )
+    project.project_dir.mkdir(parents=True, exist_ok=True)
+
+    return PipelineContext(project=project)
+
+
+ASR_PATTERNS = (r"ASR Chunk (\d+)/(\d+) completed",)
+
+
+# -- the reader --------------------------------------------------------------------------
+
+
+def test_a_line_with_a_total_reports_its_fraction():
+    reader = LogProgress(ASR_PATTERNS)
+
+    update = reader("ASR Chunk 2/4 completed (975 chars)")
+
+    assert update is not None
+    assert update.fraction == 0.5
+    assert "ASR Chunk 2/4" in update.message
+
+
+def test_the_stage_can_announce_its_own_total():
+    reader = LogProgress(
+        ASR_PATTERNS,
+        total_pattern=r"Splitting into (\d+) safe chunks",
+    )
+
+    assert reader("Splitting into 8 safe chunks (120s each)...") is None
+    assert reader("ASR Chunk 1/8 completed (975 chars)").fraction == pytest.approx(0.125)
+
+
+def test_a_bare_counter_uses_the_total_from_the_input():
+    reader = LogProgress((r"segment (\d+) speaker=",), total=10)
+
+    assert reader("segment 002 speaker=SPEAKER_00").fraction == pytest.approx(0.2)
+
+
+def test_a_counter_without_any_total_is_not_progress():
+    reader = LogProgress((r"segment (\d+) speaker=",))
+
+    assert reader("segment 004 speaker=SPEAKER_00") is None
+
+
+def test_a_line_that_says_nothing_is_not_progress():
+    reader = LogProgress(ASR_PATTERNS, total_pattern=r"Splitting into (\d+) safe chunks")
+
+    assert reader("") is None
+    assert reader("Loading checkpoint shards:  50%|#####     | 1/2") is None
+    assert reader("Setting `pad_token_id` to `eos_token_id`:151645") is None
+
+
+def test_progress_never_leaves_the_zero_to_one_range():
+    reader = LogProgress((r"line (\d+)/(\d+)",))
+
+    assert reader("line 9/8").fraction == 1.0
+    assert reader("line 0/8").fraction == 0.0
+
+
+# -- the pipeline ------------------------------------------------------------------------
+
+
+def test_a_stage_reports_progress_while_it_runs(tmp_path):
+    context = make_context(tmp_path)
+    reports = []
+    progress_inside_the_stage = []
+
+    def run(run_context):
+        run_context.on_output_line("ASR Chunk 1/2 completed (975 chars)")
+        progress_inside_the_stage.append(
+            pipeline.state.get(PipelineStage.ANALYSIS.value).progress
+        )
+        run_context.on_output_line("ASR Chunk 2/2 completed (1008 chars)")
+        return StageOutcome(value="ok")
+
+    pipeline = Pipeline(
+        context=context,
+        on_progress=reports.append,
+        handlers={},
+    )
+    pipeline.register(
+        PipelineStage.ANALYSIS,
+        StageHandler(run=run, progress=LogProgress(ASR_PATTERNS)),
+    )
+    pipeline.run()
+
+    fractions = [
+        report.progress for report in reports if report.stage == PipelineStage.ANALYSIS
+    ]
+
+    assert 0.5 in fractions
+    # The state carries the live value while the stage runs, without rewriting the
+    # state file for every line.
+    assert progress_inside_the_stage == [0.5]
+    # The finished stage still ends at 1.0 and is reported as completed.
+    assert pipeline.state.get(PipelineStage.ANALYSIS.value).status == StageStatus.COMPLETED
+    assert fractions[-1] == 1.0
+
+
+def test_a_stage_without_a_reader_gets_no_intermediate_reports(tmp_path):
+    context = make_context(tmp_path)
+    reports = []
+
+    def run(run_context):
+        run_context.on_output_line("anything at all")
+
+        return StageOutcome(value="ok")
+
+    pipeline = Pipeline(context=context, on_progress=reports.append, handlers={})
+    pipeline.register(PipelineStage.ANALYSIS, StageHandler(run=run))
+    pipeline.run()
+
+    assert [
+        report.progress for report in reports if report.stage == PipelineStage.ANALYSIS
+    ] == [0.0, 1.0]
+
+
+def test_a_broken_reader_cannot_fail_a_working_stage(tmp_path):
+    context = make_context(tmp_path)
+    reports = []
+
+    def broken_reader(_line):
+        raise ValueError("this reader is wrong")
+
+    def run(run_context):
+        run_context.on_output_line("whatever")
+
+        return StageOutcome(value="ok")
+
+    pipeline = Pipeline(context=context, on_progress=reports.append, handlers={})
+    pipeline.register(
+        PipelineStage.ANALYSIS,
+        StageHandler(run=run, progress=broken_reader),
+    )
+    pipeline.run()
+
+    assert pipeline.state.get(PipelineStage.ANALYSIS.value).status == StageStatus.COMPLETED
+
+
+def test_the_line_callback_is_cleared_after_the_stage(tmp_path):
+    context = make_context(tmp_path)
+
+    def run(run_context):
+        return StageOutcome(value="ok")
+
+    pipeline = Pipeline(
+        context=context,
+        handlers={PipelineStage.ANALYSIS: StageHandler(run=run)},
+    )
+    pipeline.run()
+
+    assert context.on_output_line is None
+
+
+# -- the runner that owns the process ----------------------------------------------------
+
+
+def test_the_runner_streams_output_lines_as_they_arrive(tmp_path):
+    script = tmp_path / "stage.py"
+    script.write_text(
+        "import time\n"
+        "for i in range(1, 4):\n"
+        "    print(f'unit {i}/3 done', flush=True)\n"
+        "    time.sleep(0.05)\n"
+    )
+    log_path = tmp_path / "stage.log"
+    seen: list[str] = []
+
+    adapters.subprocess_runner(
+        ["python3", str(script)],
+        {},
+        tmp_path,
+        log_path,
+        on_line=seen.append,
+    )
+
+    assert [line.strip() for line in seen] == [
+        "unit 1/3 done",
+        "unit 2/3 done",
+        "unit 3/3 done",
+    ]
+    # The log is written while the stage runs, so a crashed stage still has its log.
+    assert "unit 3/3 done" in log_path.read_text()
